# ==============================================================================
# CITYPULSE AI — Environment Configuration Template (.env.example)
# Duplicate this file as .env and fill in your keys if required
# ==============================================================================

# Application Meta
VITE_APP_NAME="CITYPULSE AI"
VITE_APP_TAGLINE="Explore Smart. Travel Aware."
VITE_DEFAULT_CITY="Pune, Maharashtra, India"

# Demo Mode (Simulates real-time IoT sensors, municipal feeds & fallback AI)
VITE_DEMO_MODE=true

# Optional Google Gemini API Key
# If left empty, CITYPULSE AI uses the built-in deterministic Smart AI Planner.
# You can also set this key directly in the UI under Settings.
VITE_GEMINI_API_KEY=""

# Optional External Map / Geocoding Keys
VITE_MAP_PROVIDER="osm"
VITE_MAPBOX_ACCESS_TOKEN=""

# Optional Live Weather API Key
VITE_WEATHER_API_KEY=""
